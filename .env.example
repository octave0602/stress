# Public receiving addresses only. Never put a seed phrase or private key here.
# TRON address used for both TRX and USDT TRC-20 deposits.
TRON_RECEIVE_ADDRESS=TYourTronReceiveAddress
LTC_RECEIVE_ADDRESS=ltc1yourLitecoinReceiveAddress

# Optional but recommended: TronGrid API key for reliable TRON polling.
TRONGRID_API_KEY=
# Official USDT TRC-20 contract. Change only when deliberately using another TRC-20 token.
USDT_TRC20_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj

# The service scans every 30 seconds. Orders expire after this many minutes.
CRYPTO_ORDER_TTL_MIN=30
CRYPTO_CONFIRMATIONS=12

# Optional fixed USD rates used if live rate lookup is unavailable.
TRX_USD_RATE=
LTC_USD_RATE=
